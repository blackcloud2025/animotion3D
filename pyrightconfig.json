{
  "venvPath": ".",
  "venv": ".venv-blender",
  "typeCheckingMode": "basic",
  "reportInvalidTypeForm": "none",
  "reportMissingImports": "none",
  "reportMissingModuleSource": "none",
  "exclude": [
    ".venv-blender",
    "__pycache__",
    "dist",
    "**/node_modules",
    "**/.git",
    "**/__pycache__",
    "**/.venv*"
  ]
}
